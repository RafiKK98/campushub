# Local Docker Compose settings for Milestone 8.
# Copy this file to .env and replace the placeholder values.
# Keep the password URL-safe (letters, digits, "_" or "-") because it is
# embedded in the PostgreSQL connection URL.
POSTGRES_DB=campushub
POSTGRES_USER=campushub
POSTGRES_PASSWORD=replace-with-a-url-safe-local-password

# JWT signing secret (32+ characters). Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Password for the seeded demo accounts (local development only).
DEMO_PASSWORD=CampusHubDemo!2026
