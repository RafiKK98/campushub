NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Neon pooled URL used by the application runtime adapter.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=verify-full&channel_binding=require

# Neon direct URL used by Prisma CLI migrations and the seed script.
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require

# JWT signing secret (min 32 chars). Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Frontend origin for CORS/origin checks (Vercel in production)
FRONTEND_ORIGIN=http://localhost:5173

# Auth cookie settings
AUTH_COOKIE_NAME=campushub_session
# AUTH_COOKIE_SECURE=true   # Set to true in production; defaults to NODE_ENV===production
# AUTH_COOKIE_SAME_SITE=lax # lax|strict|none; "none" requires SECURE=true
# AUTH_TOKEN_TTL_SECONDS=28800  # 8 hours

# Number of trusted reverse-proxy hops in front of Express. Do not use `true`.
# Local direct access: leave unset/0. Render only: 1.
# Vercel -> Render: Vercel sanitizes X-Forwarded-For and forwards the visitor IP;
# Render may append its proxy hop. Verify the real header chain after deployment
# and set the hop count accordingly (often 2, but confirm before relying on it).
# TRUST_PROXY=1

# Login rate limiting (per IP)
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Demo password for seeded users (local only; production seed requires explicit DEMO_PASSWORD)
# DEMO_PASSWORD=CampusHubDemo!2026
