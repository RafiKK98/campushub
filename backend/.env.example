NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Neon pooled URL used by the application runtime adapter.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=verify-full&channel_binding=require

# Neon direct URL used by Prisma CLI migrations and the seed script.
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
FRONTEND_ORIGIN=http://localhost:5173
